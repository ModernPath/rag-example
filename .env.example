# Copy to .env (or .env.local) and fill in. Both files are gitignored.
# .env / .env.local are also read from parent folders; the closest file wins.

# Gemini API key from https://aistudio.google.com/apikey
# (GOOGLE_AI_STUDIO_KEY or GOOGLE_API_KEY also work)
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# RAG_MODEL=gemini-3.8-flash                  # answer generation
# RAG_EMBEDDING_MODEL=gemini-embedding-2      # scratch engines + new File Search stores
# RAG_CHUNKING_MODEL=gemini-3.5-flash-lite    # boundaries for the scratch-semantic engine
# RAG_DATA_DIR=./data                         # local indexes and File Search state
# RAG_BASE_LANGUAGE=en                        # ISO 639-1 code: chunk titles are written in it,
#                                             # questions are translated into it before retrieval
# RAG_TRANSLATION_MODEL=gemini-3.5-flash-lite # detects the question language and translates it
# RAG_TRANSLATE_QUERIES=1                     # 0 = skip translation (questions are in the base language)
# PORT=5020                                   # web UI port

# Opt in to tests that call the real Gemini API
# RAG_LIVE_TESTS=1
